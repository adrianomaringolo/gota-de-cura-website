# Todas as variáveis abaixo são opcionais: o código tem os mesmos valores como
# padrão. Defina-as na Vercel para trocar de projeto sem alterar o código.

NEXT_PUBLIC_COMPANY_NAME="Gota de Cura"

# Firebase (chaves públicas do cliente web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# EmailJS — notificações de pedido e de inscrição em visitas
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Rotina de pedidos parados (scripts/notify-stale-orders.ts, roda no GitHub
# Actions, não no site). Sem NEXT_PUBLIC_ porque não vai para o browser.
#   - EMAILJS_PRIVATE_KEY é obrigatória: o EmailJS recusa chamadas fora do
#     browser sem ela (e é preciso habilitar "Allow EmailJS API for non-browser
#     applications" na conta).
#   - As demais só se quiser usar outra conta/serviço/template.
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
